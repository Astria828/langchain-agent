# 复制为项目根目录 .env 后生效；所有文本按 UTF-8 保存。
LOREWEAVE_APP_NAME=织境 LoreWeave API
LOREWEAVE_APP_VERSION=0.1.0
LOREWEAVE_ENVIRONMENT=development
LOREWEAVE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOREWEAVE_DATA_DIR=data
# 角色回复的输出 token 上限；调小会让长回复在 JSON 中途被截断。
LOREWEAVE_CHAT_MAX_TOKENS=8192

# 阶段 0 不配置模型密钥。后续 API Key 通过应用安全存储，不写入该文件。
